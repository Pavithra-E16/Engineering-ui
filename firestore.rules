rules_version = '2';
// GENERATED by scripts/generate-rules.mjs from src/lib/roles.js and src/data/meta.js — do not edit by hand.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return me().role; }
    function isActive() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active != false; }
    function hasRole(roles) { return isActive() && role() in roles; }
    function isStudent() { return isActive() && role() == 'student'; }
    function linked() { return me().get('linkedStudentIds', []); }

    match /settings/{docId} {
      allow read: if isActive();
      allow create: if hasRole(['admin']);
      allow update: if hasRole(['admin']);
      allow delete: if hasRole(['admin']);
    }

    match /academicYears/{docId} {
      allow read: if isActive();
      allow create: if hasRole(['admin']);
      allow update: if hasRole(['admin']);
      allow delete: if hasRole(['admin']);
    }

    match /departments/{docId} {
      allow read: if isActive();
      allow create: if hasRole(['admin']);
      allow update: if hasRole(['admin']);
      allow delete: if hasRole(['admin']);
    }

    match /programs/{docId} {
      allow read: if isActive();
      allow create: if hasRole(['admin']);
      allow update: if hasRole(['admin']);
      allow delete: if hasRole(['admin']);
    }

    match /employees/{docId} {
      allow read: if hasRole(['principal', 'admin', 'finance']);
      allow create: if hasRole(['principal', 'admin', 'finance']);
      allow update: if hasRole(['principal', 'admin', 'finance']);
      allow delete: if hasRole(['principal', 'admin', 'finance']);
    }

    match /students/{docId} {
      allow read: if hasRole(['principal', 'admin', 'finance', 'admission', 'staff', 'warden']) || (isStudent() && docId in linked());
      allow create: if hasRole(['principal', 'admin', 'admission', 'staff']);
      allow update: if hasRole(['principal', 'admin', 'admission', 'staff']);
      allow delete: if hasRole(['principal', 'admin', 'finance', 'admission', 'staff', 'warden']);
    }

    match /enquiries/{docId} {
      allow read: if hasRole(['principal', 'admin', 'finance', 'admission', 'staff']);
      allow create: if hasRole(['principal', 'admin', 'admission', 'staff']);
      allow update: if hasRole(['principal', 'admin', 'admission', 'staff']);
      allow delete: if hasRole(['principal', 'admin', 'admission', 'staff']);
    }

    match /studentActivities/{docId} {
      allow read: if hasRole(['principal', 'admin', 'finance', 'admission', 'staff', 'warden']) || (isStudent() && resource.data.studentId in linked());
      allow create: if hasRole(['principal', 'admin', 'admission', 'staff']);
      allow update: if hasRole(['principal', 'admin', 'admission', 'staff']);
      allow delete: if hasRole(['principal', 'admin', 'admission']);
    }

    match /feeHeads/{docId} {
      allow read: if isActive();
      allow create: if hasRole(['principal', 'finance']);
      allow update: if hasRole(['principal', 'finance']);
      allow delete: if hasRole(['principal', 'finance', 'admin']);
    }

    match /feeStructures/{docId} {
      allow read: if isActive();
      allow create: if hasRole(['principal', 'finance']);
      allow update: if hasRole(['principal', 'finance']);
      allow delete: if hasRole(['principal', 'finance', 'admin']);
    }

    match /invoices/{docId} {
      allow read: if hasRole(['principal', 'admin', 'finance', 'admission']) || (isStudent() && resource.data.studentId in linked());
      allow create: if hasRole(['principal', 'finance']);
      allow update: if hasRole(['principal', 'finance']);
      allow delete: if hasRole(['principal', 'finance', 'admin']);
    }

    match /payments/{docId} {
      allow read: if hasRole(['principal', 'admin', 'finance', 'admission']) || (isStudent() && resource.data.studentId in linked());
      allow create: if hasRole(['principal', 'finance']);
      allow update: if hasRole(['principal', 'finance']);
      allow delete: if hasRole(['principal', 'finance', 'admin']);
    }

    match /paymentOrders/{docId} {
      allow read: if hasRole(['principal', 'admin', 'finance']) || (isStudent() && resource.data.studentId in linked());
      allow create: if false;
      allow update: if hasRole(['principal', 'finance']) && request.resource.data.status == 'Expired' && resource.data.status in ['Created', 'Pending'];
      allow delete: if false;
    }

    match /cashBook/{docId} {
      allow read: if hasRole(['principal', 'admin', 'finance']);
      allow create: if hasRole(['principal', 'finance']);
      allow update: if hasRole(['principal', 'finance']);
      allow delete: if hasRole(['principal', 'finance', 'admin']);
    }

    match /expenses/{docId} {
      allow read: if hasRole(['principal', 'admin', 'finance']);
      allow create: if hasRole(['principal', 'finance']);
      allow update: if hasRole(['principal', 'finance']);
      allow delete: if hasRole(['principal', 'finance', 'admin']);
    }

    match /smsLogs/{docId} {
      allow read: if hasRole(['principal', 'admin', 'finance', 'admission', 'warden']);
      allow create: if hasRole(['principal', 'admin', 'finance', 'admission', 'staff', 'warden']) && request.resource.data.status == 'Queued';
      allow update: if false;
      allow delete: if hasRole(['admin']);
    }

    match /certificates/{docId} {
      allow read: if hasRole(['principal', 'admin', 'staff']) || (isStudent() && resource.data.studentId in linked());
      allow create: if (hasRole(['principal', 'admin']) || (isStudent() && request.resource.data.studentId in linked())) && request.resource.data.status == 'Pending' && request.resource.data.rollNo == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.rollNo;
      allow update: if hasRole(['principal', 'admin']);
      allow delete: if hasRole(['admin']);
    }

    match /certificateDownloads/{docId} {
      allow read: if hasRole(['principal', 'admin', 'staff']) || (isStudent() && resource.data.studentId in linked());
      allow create: if (hasRole(['principal', 'admin', 'staff']) || (isStudent() && request.resource.data.studentId in linked())) && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /certificateVerifications/{docId} {
      allow get: if true;
      allow read: if hasRole(['principal', 'admin', 'staff']) || (isStudent() && resource.data.studentId in linked());
      allow create: if hasRole(['principal', 'admin']);
      allow update: if hasRole(['principal', 'admin']);
      allow delete: if false;
    }

    match /hostels/{docId} {
      allow read: if isActive();
      allow create: if hasRole(['principal', 'admin', 'warden']);
      allow update: if hasRole(['principal', 'admin', 'warden']);
      allow delete: if hasRole(['principal', 'admin', 'warden']);
    }

    match /hostelRooms/{docId} {
      allow read: if isActive();
      allow create: if hasRole(['principal', 'admin', 'warden']);
      allow update: if hasRole(['principal', 'admin', 'warden']);
      allow delete: if hasRole(['principal', 'admin', 'warden']);
    }

    match /hostelAllocations/{docId} {
      allow read: if hasRole(['principal', 'admin', 'finance', 'staff', 'warden']) || (isStudent() && resource.data.studentId in linked());
      allow create: if hasRole(['principal', 'admin', 'warden']);
      allow update: if hasRole(['principal', 'admin', 'warden']);
      allow delete: if hasRole(['principal', 'admin', 'warden']);
    }

    match /hostelLeaves/{docId} {
      allow read: if hasRole(['principal', 'admin', 'staff', 'warden']) || (isStudent() && resource.data.studentId in linked());
      allow create: if hasRole(['principal', 'warden']) || (isStudent() && request.resource.data.studentId in linked() && request.resource.data.status == 'Pending');
      allow update: if hasRole(['principal', 'warden']) || (isStudent() && resource.data.studentId in linked() && resource.data.status == 'Pending' && request.resource.data.status == 'Cancelled');
      allow delete: if hasRole(['admin']);
    }

    match /notifications/{docId} {
      allow read: if isActive();
      allow create: if isActive();
      allow update: if isActive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'updatedAt', 'updatedBy']);
      allow delete: if hasRole(['admin']);
    }

    match /auditLogs/{docId} {
      allow read: if hasRole(['principal', 'admin']);
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /users/{docId} {
      allow read: if isActive() && (request.auth.uid == docId || hasRole(['admin', 'principal']));
      allow create: if hasRole(['admin']);
      allow update: if hasRole(['admin']) || (request.auth.uid == docId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin', 'phone', 'updatedAt', 'updatedBy']));
      allow delete: if hasRole(['admin']) && request.auth.uid != docId;
    }

    match /accessRequests/{docId} {
      allow read: if hasRole(['admin']);
      allow create: if request.resource.data.status == 'Pending' && request.resource.data.keys().hasOnly(['id', 'name', 'email', 'phone', 'requestedRole', 'departmentId', 'reference', 'message', 'status', 'active', 'createdAt', 'updatedAt']) && request.resource.data.email is string && request.resource.data.message.size() <= 1000;
      allow update: if hasRole(['admin']);
      allow delete: if hasRole(['admin']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
