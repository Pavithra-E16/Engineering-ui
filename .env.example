# ---- Firebase (leave blank to run in DEMO MODE with browser storage) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Institution ----
VITE_INSTITUTION_NAME=Kaveri Valley College of Engineering
VITE_INSTITUTION_SHORT=KVCE

# ---- AI (server-side endpoint only; NEVER put a Gemini API key here) ----
# URL of the deployed Cloud Function in functions/src/index.ts (e.g. https://<region>-<project>.cloudfunctions.net/aiAssist)
VITE_AI_ENDPOINT=

# Session timeout in minutes (default 60)
VITE_SESSION_TIMEOUT_MINUTES=60
