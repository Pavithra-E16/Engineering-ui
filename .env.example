# ---- Firebase (leave blank to run in DEMO MODE with browser storage) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Institution ----
VITE_INSTITUTION_NAME=Kaveri Valley College of Engineering
VITE_INSTITUTION_SHORT=KVCE

# ---- Online fee payment (Razorpay) ----
# Base URL of the deployed Cloud Functions, e.g. https://asia-south1-<project>.cloudfunctions.net
VITE_PAYMENTS_ENDPOINT=
# Razorpay KEY ID only (public). NEVER put the key secret here — it is a Cloud Functions secret.
VITE_RAZORPAY_KEY_ID=

# Session timeout in minutes (default 60)
VITE_SESSION_TIMEOUT_MINUTES=60
